# Supabase backend configuration
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Optional legacy names supported for compatibility
# DATABASE_URL="https://YOUR_PROJECT.supabase.co"
# STORAGE_KEY="YOUR_SERVICE_ROLE_KEY"

# Document upload limit
MAX_DOCUMENT_SIZE_BYTES=10485760

# Optional absolute path to the Tesseract executable on Windows.
# Example:
# TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
