# Backend API base URL (never put backend secrets here)
VITE_API_BASE_URL="http://localhost:5000/api"

# Supabase public client configuration.
# The anon/publishable key is safe for browser use when RLS is configured.
# NEVER put the Supabase service-role key in frontend environment variables.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# If officers enter a badge ID instead of an email, the frontend authenticates
# against <OFFICER_ID><SUFFIX>. Example: 8824-AX@verifai.local
VITE_SUPABASE_AUTH_EMAIL_SUFFIX="@verifai.local"
