# Flask API
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase public client configuration. Never put the service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional legacy alias for local setups that still use the anon-key name.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional officer badge login suffix.
VITE_SUPABASE_AUTH_EMAIL_SUFFIX=@verifai.local
